{
  "name": "meridian-erp",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@meridian/api --filter=@meridian/admin --filter=@meridian/merchant --filter=@meridian/store --filter=@meridian/distributor --filter=@meridian/landing",
    "dev:admin": "pnpm --filter @meridian/admin dev",
    "dev:landing": "pnpm --filter @meridian/landing dev",
    "dev:landing:clean": "pnpm --filter @meridian/landing dev:clean",
    "dev:merchant": "pnpm --filter @meridian/merchant dev",
    "dev:store": "pnpm --filter @meridian/store dev",
    "dev:distributor": "pnpm --filter @meridian/distributor dev",
    "dev:ui-spec": "pnpm --filter @meridian/ui-spec dev",
    "dev:api": "pnpm --filter @meridian/api dev",
    "deps": "docker compose -f docker/docker-compose.yml up -d redis",
    "docker:prod": "sh docker/prod-up.sh",
    "docker:prod:build": "docker compose -f docker/docker-compose.prod.yml --env-file docker/.env build",
    "docker:prod:up": "docker compose -f docker/docker-compose.prod.yml --env-file docker/.env up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file docker/.env down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml --env-file docker/.env logs -f",
    "docker:prod:seed": "docker compose -f docker/docker-compose.prod.yml --env-file docker/.env --profile seed run --rm api-seed",
    "db:generate": "pnpm --filter @meridian/api prisma:generate",
    "db:migrate": "pnpm --filter @meridian/api prisma:migrate",
    "db:seed": "pnpm --filter @meridian/api prisma:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:store": "playwright test --project=store",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:merchant": "playwright test --project=merchant",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  }
}
