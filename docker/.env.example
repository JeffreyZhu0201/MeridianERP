# MeridianERP — Docker production environment
# Copy to docker/.env and adjust before first deploy:
#   cp docker/.env.example docker/.env

# Public URLs (browser / NEXT_PUBLIC_* build args for Next.js portals)
NEXT_PUBLIC_API_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:3002
STORE_APP_URL=http://localhost:3003
DISTRIBUTOR_APP_URL=http://localhost:3005
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/files

# Postgres (docker internal service name: postgres)
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian

# JWT — change before production
JWT_SECRET=change-me-platform
JWT_MERCHANT_SECRET=change-me-merchant
JWT_STORE_SECRET=change-me-store
JWT_DISTRIBUTOR_SECRET=change-me-distributor
JWT_EXPIRES_IN=7d

# AI / payments / payout (demo defaults)
AI_MODE=mock
PAYOUT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Media (local volume mounted at /app/uploads in API container)
MEDIA_STORAGE=local
MEDIA_MAX_BYTES=5242880

# Optional: set to true to run prisma db seed after stack is healthy
RUN_SEED=true
