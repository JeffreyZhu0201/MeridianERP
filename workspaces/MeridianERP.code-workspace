{
  "folders": [
    { "name": "MeridianERP", "path": ".." }
  ],
  "settings": {
    "typescript.tsserver.maxTsServerMemory": 4096,
    "typescript.disableAutomaticTypeAcquisition": true,
    "typescript.preferences.includePackageJsonAutoImports": "off",
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.turbo/**": true,
      "**/dist/**": true,
      "**/.next/**": true,
      "**/coverage/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.next": true,
      "**/.turbo": true
    },
    "terminal.integrated.cwd": "${workspaceFolder:MeridianERP}"
  }
}
