# Database — Prisma Postgres (recommended)
# Provision: cd apps/api && npx prisma init --db
# Copy connection strings from Prisma Console → Settings → Database
DATABASE_URL="prisma+postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Direct TCP URL for migrations / seed (Prisma Console → Connect → Direct TCP)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Database — local Docker Postgres (optional fallback)
# Set both URLs to the same value when using local Postgres:
# docker compose -f docker/docker-compose.yml up -d postgres
# DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
# DIRECT_DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian

# Redis (local Docker — only infra dependency for local dev)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-platform
JWT_MERCHANT_SECRET=change-me-merchant
JWT_STORE_SECRET=change-me-store
JWT_DISTRIBUTOR_SECRET=change-me-distributor

# Stripe (Phase 2)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Payout (withdrawal disbursement — mock in dev)
PAYOUT_PROVIDER=mock

# AI — mock (default) or live (Anthropic-compatible API, e.g. Volcengine Ark Coding Plan)
AI_MODE=mock
# Legacy diagnosis flag (still honored if AI_MODE unset)
AI_DIAGNOSIS_MODE=mock
# Live mode credentials (also accepts AI_DIAGNOSIS_ANTHROPIC_* / ANTHROPIC_*)
AI_ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
AI_ANTHROPIC_API_KEY=your-ark-api-key
AI_ANTHROPIC_MODEL=ark-code-latest

# Media storage (local dev default; use s3 in production)
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_MAX_BYTES=5242880
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/files
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# App URLs
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:3002
STORE_APP_URL=http://localhost:3003
DISTRIBUTOR_APP_URL=http://localhost:3005

# Ports
API_PORT=3001
ADMIN_PORT=3000
MERCHANT_PORT=3002
STORE_PORT=3003
LANDING_PORT=3004
DISTRIBUTOR_PORT=3005
